---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Card from '../../components/Card.astro';

const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="News" description="Updates from the LoginOS playbook.">
  <Header />
  <main class="mx-auto max-w-content px-6 py-16 lg:px-8 lg:py-20">
    <h1 class="text-4xl font-semibold tracking-tight text-ink lg:text-5xl">News</h1>
    <p class="mt-4 text-lg text-ink-soft">Updates from the LoginOS playbook.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {news.map(({ data, slug }) => (
        <Card title={data.title} description={data.summary} href={`/news/${slug}/`} />
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
